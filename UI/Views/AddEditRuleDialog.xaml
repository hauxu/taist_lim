<Window x:Class="UI.Views.AddEditRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Toggle="clr-namespace:UI.Controls.Toggle"
        Title="添加/编辑规则"
        WindowStartupLocation="CenterOwner"
        Width="480" Height="400"
        Background="{DynamicResource StandardBackgroundBrush}"
        Foreground="{DynamicResource StandardTextBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBoxBgBrush}"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource StandardBackgroundBrush}" CornerRadius="8" 
            BorderBrush="{DynamicResource SettingPanelBorderBrush}" BorderThickness="1"
            Padding="25" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="0" ShadowDepth="0" Opacity=".15" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" x:Name="TitleText" Text="添加规则" FontSize="16" FontWeight="Bold" 
                       Foreground="{DynamicResource StandardTextBrush}" Margin="0,0,0,20"/>

            <!-- 规则类型 -->
            <TextBlock Grid.Row="1" Text="规则类型" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="1" x:Name="RuleTypeBox" Style="{StaticResource ComboBoxStyle}" 
                      HorizontalAlignment="Stretch" Margin="120,0,0,12" SelectionChanged="RuleTypeBox_SelectionChanged">
                <ComboBoxItem Content="软件"/>
                <ComboBoxItem Content="网站"/>
                <ComboBoxItem Content="浏览器"/>
            </ComboBox>

            <!-- 目标名称 -->
            <TextBlock Grid.Row="2" x:Name="TargetNameLabel" Text="显示名称" Style="{StaticResource LabelStyle}" Margin="0,0,0,3"/>
            <TextBox Grid.Row="3" x:Name="TargetNameBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

            <!-- 进程名/域名提示 -->
            <TextBlock Grid.Row="4" x:Name="ProcessNameLabel" Text="进程名" Style="{StaticResource LabelStyle}" Margin="0,0,0,3"/>
            <Grid Grid.Row="5" Margin="0,0,0,12">
                <TextBox x:Name="ProcessNameBox" Style="{StaticResource InputStyle}"/>
                <TextBlock x:Name="ProcessNameHint" Text="如 chrome、WeChat.exe" 
                           FontSize="11" Foreground="{DynamicResource SubTextBrush}" 
                           VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- 每日限制分钟数 -->
            <TextBlock Grid.Row="6" Text="每日限制（分钟）" Style="{StaticResource LabelStyle}" Margin="0,0,0,3"/>
            <TextBox Grid.Row="7" x:Name="MaxMinutesBox" Style="{StaticResource InputStyle}" Text="60" Margin="0,0,0,12"/>

            <!-- 底部区域 -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,5">
                    <TextBlock Text="超限动作：" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LockActionBox" Style="{StaticResource ComboBoxStyle}" Width="120">
                        <ComboBoxItem Content="锁屏提醒"/>
                        <ComboBoxItem Content="关闭进程"/>
                        <ComboBoxItem Content="今日禁止启动"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,5">
                    <Toggle:Toggle x:Name="EnabledToggle" IsChecked="True" OnText="启用" OffText="停用" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 按钮 -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Border Background="{DynamicResource SettingPanelBgBrush}" CornerRadius="4" 
                        Padding="20,8" Cursor="Hand" Margin="0,0,10,0"
                        BorderBrush="{DynamicResource SettingPanelBorderBrush}" BorderThickness="1"
                        MouseLeftButtonUp="CancelButton_Click">
                    <TextBlock Text="取消" FontSize="13" Foreground="{DynamicResource StandardTextBrush}"/>
                </Border>
                <Border Background="{DynamicResource ThemeBrush}" CornerRadius="4" Padding="20,8" Cursor="Hand" 
                        MouseLeftButtonUp="OkButton_Click">
                    <TextBlock Text="确定" FontSize="13" Foreground="White"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
